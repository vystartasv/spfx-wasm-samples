{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vystartasv/spfx-wasm-samples/docs/standards/sample.schema.json",
  "title": "SPFx WASM sample metadata",
  "description": "sample.yml is JSON-compatible YAML and is parsed as JSON by the repository validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "purpose", "wasm", "baseline", "execution", "network", "sharepoint", "privacy", "limits", "claims", "maturity", "licensing"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "wasm": { "type": "object", "additionalProperties": false, "required": ["used", "engine", "assets"], "properties": { "used": { "type": "boolean" }, "engine": { "type": "string", "minLength": 1 }, "assets": { "type": "string", "minLength": 1 } } },
    "baseline": { "type": "string", "minLength": 1 },
    "execution": { "type": "string", "minLength": 1 },
    "network": { "type": "string", "minLength": 1 },
    "sharepoint": { "type": "object", "additionalProperties": false, "required": ["writes", "boundary"], "properties": { "writes": { "type": "boolean" }, "boundary": { "type": "string", "minLength": 1 } } },
    "privacy": { "type": "string", "minLength": 1 },
    "limits": { "type": "string", "minLength": 1 },
    "claims": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["status", "text"], "properties": { "status": { "enum": ["VERIFIED", "EXPECTED", "EXPERIMENTAL", "NOT SUPPORTED"] }, "text": { "type": "string", "minLength": 1 } } } },
    "maturity": { "enum": ["L0", "L1", "L2"] },
    "licensing": { "type": "object", "additionalProperties": false, "required": ["notice", "dependencies"], "properties": { "notice": { "type": "string", "minLength": 1 }, "dependencies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "version", "license", "source"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "license": { "type": "string", "minLength": 1 }, "source": { "type": "string", "format": "uri" } } } } } }
  }
}
